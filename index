<script>
const els = {
  tickerContent: document.getElementById('tickerContent'),
  dateLabel: document.getElementById('dateLabel'),
  statusDot: document.getElementById('statusDot'),
  holdingValue: document.getElementById('holdingValue'),
  priceValue: document.getElementById('priceValue'),
  heartbeatLine: document.getElementById('heartbeatLine'),
  rangeRow: document.getElementById('rangeRow'),
  allTimeNote: document.getElementById('allTimeNote'),
  statTrades: document.getElementById('statTrades'),
  statPnl: document.getElementById('statPnl'),
  statWinRate: document.getElementById('statWinRate'),
  statWinRateSub: document.getElementById('statWinRateSub'),
  statAvgPnl: document.getElementById('statAvgPnl'),
