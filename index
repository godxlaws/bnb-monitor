<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BNB Trade Monitor</title>
<style>
  :root{
    --bg:#0B0E11;
    --panel:#161A1E;
    --panel2:#1E2329;
    --line:#2B3139;
    --text:#EAECEF;
    --muted:#848E9C;
    --gold:#F0B90B;
    --green:#0ECB81;
    --red:#F6465D;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:'Inter',-apple-system,'Segoe UI',sans-serif;
    min-height:100vh;
    padding-bottom:40px;
  }
  .mono{font-family:'JetBrains Mono','SF Mono',Consolas,monospace;}

  /* Ticker tape */
  .ticker-wrap{
    background:var(--panel2);
    border-bottom:1px solid var(--line);
    overflow:hidden;
    white-space:nowrap;
    padding:8px 0;
  }
  .ticker{
    display:inline-block;
    padding-left:100%;
    animation:scroll 22s linear infinite;
  }
  .ticker span{
    display:inline-block;
    padding:0 20px;
    font-size:12px;
    letter-spacing:0.3px;
  }
  @keyframes scroll{
    0%{transform:translateX(0);}
    100%{transform:translateX(-100%);}
  }
  @media (prefers-reduced-motion: reduce){
    .ticker{animation:none; padding-left:0;}
  }

  header{
    padding:20px 16px 12px;
  }
  .eyebrow{
    font-size:11px;
    color:var(--gold);
    text-transform:uppercase;
    letter-spacing:1.5px;
    margin-bottom:4px;
  }
  h1{
    font-size:22px;
    font-weight:700;
  }
  .sub{
    color:var(--muted);
    font-size:13px;
    margin-top:2px;
  }

  .status-bar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin:14px 16px 0;
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:10px;
    padding:14px 16px;
  }
  .status-left{display:flex; align-items:center; gap:10px;}
  .dot{
    width:9px; height:9px; border-radius:50%;
    background:var(--green);
    box-shadow:0 0 8px var(--green);
  }
  .dot.off{background:var(--muted); box-shadow:none;}
  .holding-label{font-size:12px; color:var(--muted);}
  .holding-value{font-size:16px; font-weight:700;}
  .price-value{font-size:16px; font-weight:700; font-family:'JetBrains Mono',monospace;}

  .grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
    margin:12px 16px;
  }
  .card{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:10px;
    padding:14px;
  }
  .card .label{font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:0.5px;}
  .card .value{font-size:20px; font-weight:700; margin-top:6px; font-family:'JetBrains Mono',monospace;}
  .value.pos{color:var(--green);}
  .value.neg{color:var(--red);}

  .section-title{
    margin:22px 16px 8px;
    font-size:13px;
    color:var(--muted);
    text-transform:uppercase;
    letter-spacing:1px;
    display:flex;
    justify-content:space-between;
    align-items:center;
  }

  .chart-wrap{
    margin:0 16px;
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:10px;
    padding:14px;
  }
  canvas{width:100%; display:block;}

  .trade-list{
    margin:0 16px;
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:10px;
    overflow:hidden;
  }
  .trade-row{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:12px 14px;
    border-bottom:1px solid var(--line);
  }
  .trade-row:last-child{border-bottom:none;}
  .trade-left{display:flex; align-items:center; gap:10px;}
  .side-tag{
    font-size:11px;
    font-weight:700;
    padding:3px 8px;
    border-radius:5px;
    letter-spacing:0.5px;
  }
  .side-tag.buy{background:rgba(14,203,129,0.15); color:var(--green);}
  .side-tag.sell{background:rgba(246,70,93,0.15); color:var(--red);}
  .trade-meta{font-size:12px; color:var(--muted); margin-top:2px;}
  .trade-right{text-align:right;}
  .trade-price{font-family:'JetBrains Mono',monospace; font-size:14px;}
  .trade-pnl{font-size:12px; margin-top:2px; font-family:'JetBrains Mono',monospace;}

  .empty{
    padding:30px 16px;
    text-align:center;
    color:var(--muted);
    font-size:13px;
  }

  .config{
    margin:24px 16px 0;
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:10px;
    padding:14px;
  }
  .config .label{font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:8px;}
  .config-row{display:flex; gap:8px;}
  input[type=text]{
    flex:1;
    background:var(--panel2);
    border:1px solid var(--line);
    color:var(--text);
    border-radius:8px;
    padding:10px 12px;
    font-size:13px;
  }
  input[type=text]:focus{outline:2px solid var(--gold); outline-offset:1px;}
  button{
    background:var(--gold);
    color:#0B0E11;
    border:none;
    border-radius:8px;
    padding:10px 16px;
    font-weight:700;
    font-size:13px;
    cursor:pointer;
  }
  button:focus-visible{outline:2px solid var(--text); outline-offset:2px;}
  button.secondary{
    background:transparent;
    border:1px solid var(--line);
    color:var(--muted);
  }
  .config-note{font-size:11px; color:var(--muted); margin-top:8px; line-height:1.5;}
  .refresh-row{display:flex; justify-content:space-between; align-items:center; margin:14px 16px 0;}
  .last-updated{font-size:11px; color:var(--muted);}

  .heartbeat{font-size:11px; color:var(--muted); margin:8px 16px 0;}

  .range-row{
    display:flex;
    gap:8px;
    margin:16px 16px 0;
    overflow-x:auto;
    padding-bottom:2px;
  }
  .chip{
    background:var(--panel);
    border:1px solid var(--line);
    color:var(--muted);
    border-radius:999px;
    padding:7px 14px;
    font-size:12px;
    font-weight:600;
    white-space:nowrap;
    cursor:pointer;
    flex-shrink:0;
  }
  .chip.active{background:var(--gold); border-color:var(--gold); color:#0B0E11;}

  .alltime-note{margin:8px 16px 0; font-size:11px; color:var(--muted);}

  .card .sub{font-size:11px; color:var(--muted); margin-top:4px;}

  .daily-table{
    margin:0 16px;
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:10px;
    overflow:hidden;
  }
  .daily-row{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:10px 14px;
    border-bottom:1px solid var(--line);
    font-size:12px;
  }
  .daily-row:last-child{border-bottom:none;}
  .daily-date{color:var(--text); font-weight:600;}
  .daily-meta{color:var(--muted); margin-top:2px; font-size:11px;}
  .daily-right{text-align:right; font-family:'JetBrains Mono',monospace;}

  .vs-wrap{
    margin:0 16px;
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:10px;
    padding:14px;
  }
  .vs-verdict{
    text-align:center;
    font-size:13px;
    font-weight:700;
    padding:10px;
    border-radius:8px;
    margin-bottom:12px;
  }
  .vs-verdict.pending{background:rgba(132,142,156,0.12); color:var(--muted); font-weight:600;}
  .vs-verdict.real{background:rgba(240,185,11,0.12); color:var(--gold);}
  .vs-verdict.shadow{background:rgba(132,142,156,0.2); color:var(--text);}
  .vs-grid{display:grid; grid-template-columns:1fr 1fr; gap:10px;}
  .vs-col{background:var(--panel2); border-radius:8px; padding:12px;}
  .vs-col-label{font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:8px;}
  .vs-stat{display:flex; justify-content:space-between; margin-top:6px; font-size:12px;}
  .vs-stat-label{color:var(--muted);}
  .vs-stat-value{font-family:'JetBrains Mono',monospace; font-weight:700;}
  .vs-note{font-size:11px; color:var(--muted); margin-top:10px; line-height:1.5;}
</style>
</head>
<body>

